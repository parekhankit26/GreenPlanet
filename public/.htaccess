# SPA fallback: serve index.html for client-side routes (/wonders, /mission, /gallery)
# so deep links and refreshes don't 404 on Apache / cPanel hosting.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Leave real files and directories alone (assets, /hero images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else goes to the app shell
  RewriteRule . /index.html [L]
</IfModule>
